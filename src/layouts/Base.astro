---
import { Font } from 'astro:assets';
import { PUBLIC_DEPLOY_ENV } from 'astro:env/client';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import ThemeScript from '../components/layout/ThemeScript.astro';
import { cssVariableOf, germanFont } from '../config/fonts.ts';
import { type LevelId, site } from '../config/site.ts';
import { getLocaleConfig, type LocaleCode, readyLocales } from '../i18n/locales.ts';
import { alternates, localizePath, t } from '../i18n/utils.ts';
import { getReferenceLinks } from '../lib/reference.ts';
import { jsonLd, type StructuredData } from '../lib/seo.ts';
import { getTopicLinks } from '../lib/topics.ts';
import '../styles/global.css';

type CssVariable = import('astro:assets').CssVariable;

interface Props {
  locale: LocaleCode;
  title?: string | undefined;
  description?: string | undefined;
  /** Force noindex for this page (e.g. coming-soon pages). */
  noindex?: boolean;
  /**
   * 404 page: served for any unknown URL, so noindex, no canonical, hreflang or `og:url`, and the
   * language picker links to the home page of each locale.
   */
  notFound?: boolean;
  /** Level of the page: shows the sidebar with that level's topics. */
  level?: LevelId | undefined;
  /** Reference section page: shows the sidebar with the reference pages (ignored with `level`). */
  reference?: boolean;
  /** Slug of the topic or reference page: marks it in the sidebar. */
  topic?: string | undefined;
  /** Open Graph type: `article` for topic pages */
  ogType?: 'website' | 'article';
  /** schema.org data, rendered as JSON-LD */
  structuredData?: StructuredData | readonly StructuredData[] | undefined;
}

const {
  locale,
  title,
  description,
  noindex = false,
  notFound = false,
  level,
  reference = false,
  topic,
  ogType = 'website',
  structuredData,
} = Astro.props;
const localeConfig = getLocaleConfig(locale);
const path = notFound ? '/' : Astro.url.pathname;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const robotsNoindex = noindex || notFound || !localeConfig.ready || PUBLIC_DEPLOY_ENV === 'preview';
const canonical = new URL(localizePath(path, locale), site.url).href;
const metaDescription = description ?? t(locale, 'site.tagline');
const ogLocaleAlternates = localeConfig.ready
  ? readyLocales.filter((code) => code !== locale).map((code) => getLocaleConfig(code).ogLocale)
  : [];

const bodyFont = cssVariableOf(localeConfig.font.family) as CssVariable;
const germanFontVar = cssVariableOf(germanFont.family) as CssVariable;
const fontPreload = localeConfig.font.preload.map((subset) => ({
  subset,
  style: 'normal' as const,
}));

const topics = level ? await getTopicLinks(locale) : [];
const referenceSection = !level && reference;
const references = referenceSection ? await getReferenceLinks(locale) : [];
const hasSidebar = Boolean(level) || referenceSection;
---

<!doctype html>
<html
  lang={localeConfig.code}
  dir={localeConfig.dir}
  style={`--font-body: var(${bodyFont}); --font-de: var(${germanFontVar})`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ThemeScript />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    {!notFound && <link rel="canonical" href={canonical} />}
    {!notFound &&
      alternates(path, site.url).map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={metaDescription} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={localeConfig.ogLocale} />
    {ogLocaleAlternates.map((ogLocale) => (
      <meta property="og:locale:alternate" content={ogLocale} />
    ))}
    <meta name="twitter:card" content="summary" />
    {structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
    <Font cssVariable={bodyFont} preload={fontPreload} />
    {germanFontVar !== bodyFont && <Font cssVariable={germanFontVar} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-ui bg-accent px-3 py-2 text-accent-fg focus:not-sr-only focus:fixed focus:start-2 focus:top-2"
    >
      {t(locale, 'site.skipToContent')}
    </a>
    <Header
      locale={locale}
      path={path}
      active={level ?? (referenceSection ? 'reference' : undefined)}
      hasSidebar={hasSidebar}
    />
    <!-- Fills the screen between header and footer, so short pages do not scroll. -->
    <div class="mx-auto flex w-full max-w-6xl flex-1">
      {level && <Sidebar locale={locale} level={level} topics={topics} current={topic} />}
      {referenceSection && <Sidebar locale={locale} references={references} current={topic} />}
      <main
        id="main"
        class:list={[
          'min-w-0 flex-1 px-4 py-6 lg:px-6',
          hasSidebar && 'lg:border-s lg:border-border',
        ]}
      >
        <slot />
      </main>
    </div>
    <!-- Full width under sidebar and content. -->
    <Footer locale={locale} />
  </body>
</html>
