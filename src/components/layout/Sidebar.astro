---
/**
 * Topics of the current level grouped by category, or on reference pages the list of reference
 * pages. Static column from lg up; below lg the same element is a sheet opened by the header's
 * menu button (Popover API: no JavaScript, light dismiss, Esc closes it).
 */
import { categoryIds, type LevelId, levels } from '../../config/site.ts';
import type { LocaleCode } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';
import {
  groupByCategory,
  type ReferenceLink,
  referencePath,
  type TopicLink,
  topicPath,
} from '../../lib/navigation.ts';
import LevelSwitcher from './LevelSwitcher.astro';

type Props = {
  locale: LocaleCode;
  /** Slug of the current topic or reference page */
  current?: string | undefined;
} & (
  | { level: LevelId; topics: readonly TopicLink[] }
  | { level?: undefined; references: readonly ReferenceLink[] }
);

const props = Astro.props;
const { locale, current } = props;
const level = props.level;
const groups = props.level ? groupByCategory(props.topics, props.level, categoryIds) : [];
const references = props.level ? [] : props.references;
const levelInfo = levels.find((entry) => entry.id === level);
const linkClass = (active: boolean) => [
  'block rounded-e-ui border-s-2 px-3 py-1 text-[0.9375rem]',
  active ? 'border-accent bg-surface font-semibold' : 'border-transparent hover:bg-surface',
];
---

<div id="sidebar" popover class="sidebar">
  <div class="flex items-center justify-between lg:hidden">
    <span class="font-bold">{t(locale, 'nav.menu')}</span>
    <button
      type="button"
      popovertarget="sidebar"
      popovertargetaction="hide"
      aria-label={t(locale, 'nav.closeMenu')}
      class="-me-2 inline-flex size-10 items-center justify-center rounded-ui hover:bg-surface"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <LevelSwitcher locale={locale} active={level ?? 'reference'} class="mt-2 mb-4 lg:hidden" />
  {level ? (
    <nav aria-label={t(locale, 'nav.topics')}>
      <p class="px-3 font-bold">
        <a href={localizePath(`/${level}/`, locale)} class="hover:text-accent">
          {t(locale, 'level.title', { level: levelInfo?.label ?? level })}
        </a>
      </p>
      {groups.map((group) => (
        <section class="mt-4">
          <h2 class="eyebrow text-muted px-3">{t(locale, `category.${group.category}`)}</h2>
          <ul class="mt-1">
            {group.topics.map((topic) => (
              <li>
                <a
                  href={localizePath(topicPath(topic), locale)}
                  aria-current={topic.slug === current ? 'page' : undefined}
                  class:list={linkClass(topic.slug === current)}
                >
                  {topic.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {groups.length === 0 && (
        <p class="mt-2 px-3 text-sm text-muted">
          {t(locale, levelInfo?.available ? 'level.noTopics' : 'level.comingSoon')}
        </p>
      )}
    </nav>
  ) : (
    <nav aria-label={t(locale, 'nav.referencePages')}>
      <p class="px-3 font-bold">
        <a href={localizePath(referencePath(), locale)} class="hover:text-accent">
          {t(locale, 'reference.title')}
        </a>
      </p>
      <ul class="mt-2">
        {references.map((page) => (
          <li>
            <a
              href={localizePath(referencePath(page.slug), locale)}
              aria-current={page.slug === current ? 'page' : undefined}
              class:list={linkClass(page.slug === current)}
            >
              {page.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</div>

<style>
  /* Below lg: a sheet from the start edge (the UA hides it until opened). */
  .sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline: 0 auto;
    margin: 0;
    width: min(20rem, 85vw);
    height: 100dvh;
    max-height: none;
    overflow-y: auto;
    padding: 0.5rem 1rem 1.5rem;
    border: 0;
    border-inline-end: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg);
  }

  .sidebar::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  /*
   * lg and up: a static column next to the content, as tall as its topics (at most the screen
   * below the header, then it scrolls). The divider is the content column's border, so it runs
   * down to the footer.
   */
  @media (width >= 64rem) {
    .sidebar {
      display: block;
      position: sticky;
      inset-block: 3rem auto;
      align-self: flex-start;
      flex: none;
      width: 15rem;
      height: auto;
      max-height: calc(100dvh - 3rem);
      padding: 1.25rem 0.75rem;
      border-inline-end: 0;
    }
  }
</style>
