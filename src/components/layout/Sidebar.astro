---
/**
 * Topics of the current level grouped by category. Static column from lg up; below lg the same
 * element is a sheet opened by the header's menu button (Popover API: no JavaScript, light dismiss,
 * Esc closes it).
 */
import { categoryIds, type LevelId, levels } from '../../config/site.ts';
import type { LocaleCode } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';
import { groupByCategory, type TopicLink, topicPath } from '../../lib/navigation.ts';
import LevelSwitcher from './LevelSwitcher.astro';

interface Props {
  locale: LocaleCode;
  level: LevelId;
  topics: readonly TopicLink[];
  /** Slug of the current topic page */
  current?: string | undefined;
}

const { locale, level, topics, current } = Astro.props;
const groups = groupByCategory(topics, level, categoryIds);
const levelInfo = levels.find((entry) => entry.id === level);
---

<div id="sidebar" popover class="sidebar">
  <div class="flex items-center justify-between lg:hidden">
    <span class="font-bold">{t(locale, 'nav.menu')}</span>
    <button
      type="button"
      popovertarget="sidebar"
      popovertargetaction="hide"
      aria-label={t(locale, 'nav.closeMenu')}
      class="-me-2 inline-flex size-10 items-center justify-center rounded-ui hover:bg-surface"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <LevelSwitcher locale={locale} active={level} class="mt-2 mb-4 lg:hidden" />
  <nav aria-label={t(locale, 'nav.topics')}>
    <p class="px-3 font-bold">
      <a href={localizePath(`/${level}/`, locale)} class="hover:text-accent">
        {t(locale, 'level.title', { level: levelInfo?.label ?? level })}
      </a>
    </p>
    {groups.map((group) => (
      <section class="mt-4">
        <h2 class="eyebrow text-muted px-3">{t(locale, `category.${group.category}`)}</h2>
        <ul class="mt-1">
          {group.topics.map((topic) => (
            <li>
              <a
                href={localizePath(topicPath(topic), locale)}
                aria-current={topic.slug === current ? 'page' : undefined}
                class:list={[
                  'block rounded-e-ui border-s-2 px-3 py-1 text-[0.9375rem]',
                  topic.slug === current
                    ? 'border-accent bg-surface font-semibold'
                    : 'border-transparent hover:bg-surface',
                ]}
              >
                {topic.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {groups.length === 0 && (
      <p class="mt-2 px-3 text-sm text-muted">
        {t(locale, levelInfo?.available ? 'level.noTopics' : 'level.comingSoon')}
      </p>
    )}
  </nav>
</div>

<style>
  /* Below lg: a sheet from the start edge (the UA hides it until opened). */
  .sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline: 0 auto;
    margin: 0;
    width: min(20rem, 85vw);
    height: 100dvh;
    max-height: none;
    overflow-y: auto;
    padding: 0.5rem 1rem 1.5rem;
    border: 0;
    border-inline-end: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg);
  }

  .sidebar::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  /* lg and up: a static column next to the content. */
  @media (width >= 64rem) {
    .sidebar {
      display: block;
      position: sticky;
      inset-block: 3rem auto;
      flex: none;
      width: 15rem;
      height: calc(100dvh - 3rem);
      padding: 1.25rem 0.75rem;
      view-transition-name: sidebar;
    }
  }
</style>
