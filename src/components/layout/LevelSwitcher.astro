---
import { type LevelId, levels } from '../../config/site.ts';
import type { LocaleCode } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';

interface Props {
  locale: LocaleCode;
  /** Level of the current page, if any */
  active?: LevelId | undefined;
  class?: string;
}

const { locale, active, class: className } = Astro.props;
---

<nav aria-label={t(locale, 'nav.levels')} class={className}>
  <ul class="flex flex-wrap items-center gap-1">
    {levels.map((level) => (
      <li>
        <a
          href={localizePath(`/${level.id}/`, locale)}
          aria-current={level.id === active ? 'true' : undefined}
          class:list={[
            'inline-flex rounded-ui px-3 py-1 text-sm font-semibold',
            level.id === active ? 'bg-nav-active text-nav-active-fg' : 'hover:bg-surface',
            !level.available && 'font-normal text-muted',
          ]}
        >
          {level.label}
          {/* Muted color shows "coming soon"; screen readers get it as text (WCAG 1.4.1). */}
          {!level.available && <span class="sr-only"> ({t(locale, 'level.soon')})</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>
