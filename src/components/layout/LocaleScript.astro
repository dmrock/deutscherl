---
/**
 * Language choice and hint (CLAUDE.md, "Languages"). Place at the end of <body>.
 * - Clicking an a[data-locale] link (language picker, hint) saves localStorage `locale`.
 * - The hint for another ready locale is shown when the saved locale differs from this page's, or,
 *   with nothing saved, when the best match in navigator.languages is another ready locale.
 *   Dismissal is saved per locale (`hint-dismissed:<code>`).
 * The hint markup and texts are server-rendered (LanguageHint.astro); this only un-hides one.
 */
---

<script is:inline>
  (() => {
    const get = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const set = (key, value) => {
      try {
        localStorage.setItem(key, value);
      } catch {}
    };
    document.addEventListener('click', (event) => {
      const link = event.target.closest?.('a[data-locale]');
      if (link) set('locale', link.dataset.locale);
    });
    const current = document.documentElement.dataset.locale;
    const hints = [...document.querySelectorAll('[data-language-hint]')];
    const others = hints.map((hint) => hint.dataset.languageHint);
    let target = get('locale');
    if (!target) {
      for (const language of navigator.languages || []) {
        const code = language.toLowerCase().split('-')[0];
        if (code === current || others.includes(code)) {
          target = code;
          break;
        }
      }
    }
    const hint = hints.find((element) => element.dataset.languageHint === target);
    if (!hint || get(`hint-dismissed:${target}`)) return;
    hint.hidden = false;
    hint.querySelector('[data-hint-dismiss]').addEventListener('click', () => {
      set(`hint-dismissed:${target}`, '1');
      hint.hidden = true;
    });
  })();
</script>
