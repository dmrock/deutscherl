---
import { type LevelId, site } from '../../config/site.ts';
import type { LocaleCode } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';
import LanguagePicker from './LanguagePicker.astro';
import LevelSwitcher from './LevelSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: LocaleCode;
  path: string;
  level?: LevelId | undefined;
  /** Show the menu button that opens the sidebar sheet (below lg) */
  hasSidebar: boolean;
}

const { locale, path, level, hasSidebar } = Astro.props;
---

<header class="site-header sticky top-0 z-30 border-b border-border bg-header backdrop-blur-md">
  <div class="mx-auto flex h-12 max-w-6xl items-center gap-1 px-4">
    {hasSidebar && (
      <button
        type="button"
        popovertarget="sidebar"
        aria-label={t(locale, 'nav.menu')}
        class="-ms-2 inline-flex size-10 items-center justify-center rounded-ui hover:bg-surface lg:hidden"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    )}
    <a
      href={localizePath('/', locale)}
      class="me-auto inline-flex items-center gap-2 text-lg font-bold tracking-tight lg:me-5"
    >
      <span class="brand-mark" aria-hidden="true"></span>
      {site.name}
    </a>
    <LevelSwitcher locale={locale} active={level} class="me-auto hidden lg:block" />
    <button
      type="button"
      disabled
      aria-label={t(locale, 'search.soon')}
      title={t(locale, 'search.soon')}
      class="inline-flex size-10 items-center justify-center rounded-ui text-muted"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
    </button>
    <LanguagePicker locale={locale} path={path} />
    <ThemeToggle locale={locale} />
  </div>
</header>
