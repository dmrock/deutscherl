---
/**
 * A German word inside explanation text: `<De>haben</De>`, bold in the locale font. `plain` drops
 * the bold for text that is German throughout (cells of a forms table); `**…**` inside then marks
 * what to notice (`<De plain>du **lässt**</De>`).
 */
interface Props {
  plain?: boolean;
}

const { plain = false } = Astro.props;
---

{plain ? (
  <span lang="de">
    <slot />
  </span>
) : (
  <b lang="de" class="font-semibold">
    <slot />
  </b>
)}
