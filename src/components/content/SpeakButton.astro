---
/**
 * Audio button for a German text (Web Speech API, placeholder until recorded audio exists).
 * Rendered hidden; SpeakScript shows it when the browser can speak and handles clicks.
 */
import type { LocaleCode } from '../../i18n/locales.ts';
import { t } from '../../i18n/utils.ts';
import { stripMarks } from '../../lib/marked-text.ts';

interface Props {
  locale: LocaleCode;
  text: string;
}

const { locale, text } = Astro.props;
---

<button
  type="button"
  hidden
  data-speak={stripMarks(text)}
  aria-label={t(locale, 'topic.listen')}
  class="inline-flex size-9 flex-none items-center justify-center rounded-ui bg-accent-soft text-accent hover:bg-surface"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="size-4.5"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M11 5 6 9H3v6h3l5 4V5z"></path>
    <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path>
  </svg>
</button>
