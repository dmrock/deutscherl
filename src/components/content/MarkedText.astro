---
/**
 * Native-language text where `*word*` marks a German word (summary, why texts): marked words get
 * lang="de" for screen readers, speech and hyphenation, and are bold like <De>.
 */
import { splitMarked } from '../../lib/marked-text.ts';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

{splitMarked(text, '*').map((segment) =>
  segment.marked ? (
    <b lang="de" class="font-semibold">
      {segment.text}
    </b>
  ) : (
    segment.text
  ),
)}
