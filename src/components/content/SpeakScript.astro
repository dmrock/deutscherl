---
/**
 * Speech for [data-speak] buttons (CLAUDE.md, "UX rules": Web Speech API placeholder). Shows the
 * buttons only when the browser has speechSynthesis; prefers a de-AT voice, then de-DE, then any
 * German voice.
 */
---

<script is:inline>
  (() => {
    const synth = window.speechSynthesis;
    if (!synth) return;
    const show = () => {
      for (const button of document.querySelectorAll('[data-speak]')) button.hidden = false;
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', show);
    else show();
    document.addEventListener('click', (event) => {
      const button = event.target.closest?.('[data-speak]');
      if (!button) return;
      const voices = synth.getVoices();
      const find = (lang) => voices.find((voice) => voice.lang.replace('_', '-') === lang);
      const voice =
        find('de-AT') || find('de-DE') || voices.find((voice) => /^de\b/i.test(voice.lang));
      const utterance = new SpeechSynthesisUtterance(button.dataset.speak);
      utterance.lang = voice ? voice.lang : 'de-DE';
      if (voice) utterance.voice = voice;
      synth.cancel();
      synth.speak(utterance);
    });
  })();
</script>
