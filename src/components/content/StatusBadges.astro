---
/** Review badges of a topic page (src/lib/review-badges.ts), plus the link to the English page. */
import { defaultLocale, type LocaleCode } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';
import type { Review } from '../../lib/content-schemas.ts';
import { isPositive, reviewBadges } from '../../lib/review-badges.ts';

interface Props {
  locale: LocaleCode;
  review: Review | undefined;
  path: string;
}

const { locale, review, path } = Astro.props;
const badges = reviewBadges(review, locale, defaultLocale);
---

<ul class="flex flex-wrap gap-2" aria-label={t(locale, 'review.status')}>
  {badges.map((badge) =>
    isPositive(badge) ? (
      <li
        data-badge={badge}
        class="inline-flex items-center gap-1 rounded-chip bg-success-soft px-2.5 py-1 font-semibold text-success"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        {t(locale, `review.${badge}`)}
      </li>
    ) : (
      <li
        data-badge={badge}
        class="inline-flex items-center rounded-chip border border-border px-2.5 py-1 text-muted"
      >
        {t(locale, `review.${badge}`)}
      </li>
    ),
  )}
</ul>
{locale !== defaultLocale && (
  <a
    href={localizePath(path, defaultLocale)}
    hreflang={defaultLocale}
    class="inline-flex items-center px-1 py-1 text-accent underline underline-offset-2"
  >
    {t(locale, 'review.englishVersion')}
  </a>
)}
