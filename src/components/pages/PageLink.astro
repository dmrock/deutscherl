---
/** Link to another page of the site in the current locale: `<PageLink href="/legal/">`. */
import { getLocaleFromPath, localizePath } from '../../i18n/utils.ts';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={localizePath(href, getLocaleFromPath(Astro.url.pathname))}>
  <slot />
</a>
