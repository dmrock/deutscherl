---
/**
 * Font specimen page (not built for production, see the `dev-pages` integration in astro.config.ts).
 * Shows every site font (locale fonts from locales.ts and the German font) with the same German
 * and native-language samples at body and example size, in light and dark (CLAUDE.md, "Fonts").
 * Developer tool: labels are plain English, not UI strings.
 */
import { Font } from 'astro:assets';
import { statSync } from 'node:fs';
import { createRequire } from 'node:module';
import germanSample from '../../tests/fixtures/fonts/german-sample.txt?raw';
import russianSample from '../../tests/fixtures/i18n/ru/font-sample.txt?raw';
import { allFonts, cssVariableOf, germanFont, mergeFonts } from '../config/fonts.ts';
import type { LocaleFont } from '../i18n/locales.ts';
import '../styles/global.css';

type CssVariable = import('astro:assets').CssVariable;

const require = createRequire(import.meta.url);

/** Size of one subset's woff2 file (normal style), in KB. */
function subsetKb(font: LocaleFont, subset: string): string {
  const { id } = require(`${font.package}/metadata.json`) as { id: string };
  const file = require.resolve(`${font.package}/files/${id}-${subset}-wght-normal.woff2`);
  return `${subset} ${Math.round(statSync(file).size / 1024)} KB`;
}

const fonts = mergeFonts(allFonts());
const germanVar = cssVariableOf(germanFont.family);
const fontVar = (font: LocaleFont) => `var(${cssVariableOf(font.family)})`;

const specimenLine = 'Il1 | O0 | äöü ÄÖÜ ß ẞ | 0123456789';
const sizes = [
  { label: 'Body (1rem)', className: 'text-base' },
  { label: 'Example (1.125rem)', className: 'text-german' },
];
const themes = ['light', 'dark'] as const;
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Font specimens</title>
    {fonts.map((font) => (
      <Font cssVariable={cssVariableOf(font.family) as CssVariable} />
    ))}
  </head>
  <body class="font-[system-ui]">
    <main class="mx-auto max-w-7xl px-4 py-8">
      <h1 class="text-3xl font-bold">Font specimens</h1>
      <p class="mt-2 text-muted">
        German blocks always use {germanFont.family}. Samples come from
        <code>tests/fixtures/</code>.
      </p>

      {fonts.map((font) => {
        const cyrillic = font.subsets.includes('cyrillic');
        return (
          <section class="mt-12">
            <h2 class="text-2xl font-bold">{font.family}</h2>
            <p class="mt-1 text-sm text-muted">
              {font.subsets.map((subset) => subsetKb(font, subset)).join(', ')}
            </p>
            <div class="mt-4 grid gap-4 lg:grid-cols-2">
              {themes.map((theme) => (
                <div data-theme={theme} class="rounded-lg border border-border bg-bg p-4 text-fg">
                  <p class="text-xs tracking-wide text-muted uppercase">{theme}</p>
                  <p class="mt-2 text-2xl" style={`font-family: ${fontVar(font)}`} lang="de">
                    {specimenLine}
                  </p>
                  {sizes.map((size) => (
                    <div class="mt-4">
                      <p class="text-xs text-muted">{size.label}</p>
                      {cyrillic && (
                        <p
                          class={`mt-1 ${size.className}`}
                          style={`font-family: ${fontVar(font)}`}
                          lang="ru"
                        >
                          {russianSample}
                        </p>
                      )}
                      <p
                        class={`mt-2 ${size.className}`}
                        style={`font-family: ${fontVar(font)}`}
                        lang="de"
                      >
                        {germanSample}
                      </p>
                    </div>
                  ))}
                  {cyrillic && (
                    <div class="mt-4">
                      <p class="text-xs text-muted">
                        Real mix on a ru page: explanation + German example
                      </p>
                      <p class="mt-1" style={`font-family: ${fontVar(font)}`} lang="ru">
                        {russianSample}
                      </p>
                      <p
                        class="mt-2 rounded-md bg-surface p-3 text-german"
                        style={`font-family: var(${germanVar})`}
                        lang="de"
                      >
                        {germanSample}
                      </p>
                      <p class="mt-2 font-bold" style={`font-family: ${fontVar(font)}`} lang="ru">
                        {russianSample.split('.')[0]}.
                      </p>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </main>
  </body>
</html>
