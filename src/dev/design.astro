---
/**
 * Component sample (dev and previews only, never in production): a topic page with static
 * mock-ups of the stage 3 and 4 components (In short, rule table, examples, Austrian note, badges,
 * exercises) in the chosen design (decision #45). It is the visual reference for building them;
 * stage 3 removes it once the real components render on a topic page. Labels are plain
 * English (developer page, not UI strings); German samples live in tests/fixtures/design/.
 */
import sample from '../../tests/fixtures/design/sample.json';
import Base from '../layouts/Base.astro';

/** Splits `**bold**` markers: odd parts are the highlighted verb forms. */
const parts = (text: string) => text.split('**');

const iconProps = {
  'aria-hidden': 'true',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
} as const;

const chip = 'german rounded-chip border border-control bg-card px-3 py-1 shadow-card';
---

<Base locale="en" title="Design sample" level="a2" topic="perfekt" noindex>
  <article class="max-w-prose">
    <p class="eyebrow text-muted">A2 · Verbs</p>
    <h1 class="mt-1 text-3xl sm:text-4xl">Perfekt: haben or sein?</h1>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      <span class="inline-flex items-center gap-1 rounded-chip bg-success-soft px-2.5 py-1 font-semibold text-success">
        <svg {...iconProps} class="size-3.5">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        Checked by a teacher
      </span>
      <span class="inline-flex items-center rounded-chip border border-border px-2.5 py-1 text-muted">
        Draft
      </span>
      <span class="inline-flex items-center px-1 py-1 text-muted">5 min read</span>
    </div>

    <aside class="mt-5 rounded-card bg-accent-soft px-4 py-3">
      <p class="eyebrow text-accent">In short</p>
      <p class="mt-0.5 text-lg">
        Most verbs form the Perfekt with <i lang="de">haben</i>. Verbs of movement and change of
        state use <i lang="de">sein</i>.
      </p>
    </aside>

    <h2 class="mt-8 text-2xl">How it works</h2>
    <p class="mt-3">
      The Perfekt has two parts: a form of <i lang="de">haben</i> or <i lang="de">sein</i> in
      position two, and the past participle at the very end of the sentence. Verbs like{' '}
      <a href="#" lang="de" class="word">
        fahren
      </a>{' '}
      use <i lang="de">sein</i>, because you move from one place to another.
    </p>

    <div class="mt-5 overflow-x-auto rounded-card border border-border">
      <table class="w-full text-start text-[0.9375rem]">
        <thead class="bg-surface">
          <tr>
            <th scope="col" class="px-4 py-2 text-start" lang="de">
              haben
            </th>
            <th scope="col" class="border-s border-border px-4 py-2 text-start" lang="de">
              sein
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <td class="px-4 py-2">Most verbs</td>
            <td class="border-s border-border px-4 py-2">Movement from A to B</td>
          </tr>
          <tr>
            <td class="px-4 py-2">Verbs with an accusative object</td>
            <td class="border-s border-border px-4 py-2">Change of state</td>
          </tr>
          <tr>
            <td class="px-4 py-2">Reflexive verbs</td>
            <td class="border-s border-border px-4 py-2">
              <span lang="de">sein, bleiben, werden</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="group mt-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl">Examples</h2>
        <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-muted">
          <input type="checkbox" class="size-4 accent-accent" />
          Hide translation
        </label>
      </div>
      <ul class="mt-4 divide-y divide-border rounded-card border border-border bg-card shadow-card">
        {sample.examples.map((example) => (
          <li class="flex items-start gap-3 px-4 py-3">
            <button
              type="button"
              aria-label="Listen"
              class="inline-flex size-9 flex-none items-center justify-center rounded-ui bg-accent-soft text-accent"
            >
              <svg {...iconProps} class="size-4.5">
                <path d="M11 5 6 9H3v6h3l5 4V5z" />
                <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
              </svg>
            </button>
            <div>
              <p lang="de" class="german">
                {parts(example.de).map((part, index) =>
                  index % 2 ? <strong class="font-semibold text-accent">{part}</strong> : part,
                )}
              </p>
              <p class="text-muted group-has-[:checked]:invisible">{example.en}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <aside class="mt-6 rounded-card border border-border bg-card p-4 shadow-card">
      <p class="flex items-center gap-2 font-semibold">
        <span class="flag" aria-hidden="true"></span>
        In Austria
      </p>
      <p class="mt-2">
        Verbs of position (<i lang="de">sitzen, liegen, stehen</i>) form the Perfekt with{' '}
        <i lang="de">sein</i> in Austria and southern Germany.
      </p>
      <p lang="de" class="german mt-3">
        {parts(sample.austrian.de).map((part, index) =>
          index % 2 ? <strong class="font-semibold text-accent">{part}</strong> : part,
        )}
      </p>
      <p class="text-muted">{sample.austrian.en}</p>
    </aside>

    <aside class="mt-6 flex items-center gap-3 rounded-card border border-dashed border-control px-4 py-3 text-sm text-muted">
      <span class="rounded-chip border border-control px-2 py-0.5 text-xs font-semibold">Ad</span>
      Sponsor banner: a static image with a link, no tracking.
    </aside>
  </article>

  <section id="practice" class="mt-10 max-w-prose scroll-mt-16" aria-labelledby="practice-title">
    <h2 id="practice-title" class="text-2xl">
      Practice
    </h2>

    <div class="mt-4 rounded-card border border-border bg-card p-4 shadow-card">
      <div class="flex items-center justify-between gap-3 text-sm text-muted">
        <span>Question 2 of 5</span>
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-success"></span>
          <span class="size-2.5 rounded-full bg-accent ring-2 ring-accent-soft"></span>
          <span class="size-2.5 rounded-full border border-control"></span>
          <span class="size-2.5 rounded-full border border-control"></span>
          <span class="size-2.5 rounded-full border border-control"></span>
        </span>
      </div>
      <p lang="de" class="german mt-4">
        {sample.choice.before}
        <span class="inline-block min-w-16 border-b-2 border-control text-center font-semibold text-danger">
          {sample.choice.picked}
        </span>
        {sample.choice.after}
      </p>
      <div class="mt-4 grid grid-cols-2 gap-3">
        {sample.choice.options.map((option) => (
          <button
            type="button"
            lang="de"
            class:list={[
              'german flex items-center justify-center gap-2 rounded-ui border-2 px-4 py-2 font-semibold',
              option === sample.choice.answer && 'border-success bg-success-soft text-success',
              option === sample.choice.picked && 'border-danger bg-danger-soft text-danger',
            ]}
          >
            {option === sample.choice.answer && (
              <svg {...iconProps} class="size-4.5">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            )}
            {option === sample.choice.picked && (
              <svg {...iconProps} class="size-4.5">
                <path d="M6 6l12 12M18 6 6 18" />
              </svg>
            )}
            {option}
          </button>
        ))}
      </div>
      <div class="mt-4 rounded-card bg-danger-soft p-4">
        <p class="font-semibold text-danger">Not quite. The answer is “bin”.</p>
        <p class="mt-1">
          <i lang="de">gehen</i> is movement from one place to another, so the Perfekt uses{' '}
          <i lang="de">sein</i>.
        </p>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <a href="#" class="text-sm text-muted underline underline-offset-2 hover:text-accent">
          Report a mistake
        </a>
        <button
          type="button"
          class="inline-flex h-10 items-center rounded-ui bg-accent px-5 font-semibold text-accent-fg"
        >
          Next
        </button>
      </div>
    </div>

    <div class="mt-4 rounded-card border border-border bg-card p-4 shadow-card">
      <p class="text-sm text-muted">Put the words in order</p>
      <p class="mt-1">{sample.wordOrder.translation}</p>
      <div class="mt-4 flex items-end gap-1">
        <ul
          lang="de"
          aria-label="Your answer"
          class="flex min-h-14 flex-1 flex-wrap items-center gap-2 rounded-card border-2 border-dashed border-control p-2"
        >
          {sample.wordOrder.line.map((word) => (
            <li class={chip}>{word}</li>
          ))}
        </ul>
        <span lang="de" class="german pb-3">
          {sample.wordOrder.punctuation}
        </span>
      </div>
      <ul
        lang="de"
        aria-label="Word bank"
        class="mt-3 flex min-h-14 flex-wrap items-center gap-2 rounded-card bg-surface p-2"
      >
        {sample.wordOrder.bank.map((word) => (
          <li class={chip}>{word}</li>
        ))}
      </ul>
      <div class="mt-4 flex justify-end gap-3">
        <button
          type="button"
          class="inline-flex h-10 items-center rounded-ui border border-control px-4 font-semibold"
        >
          Reset
        </button>
        <button
          type="button"
          disabled
          class="inline-flex h-10 items-center rounded-ui bg-accent px-5 font-semibold text-accent-fg opacity-50"
        >
          Check
        </button>
      </div>
    </div>

    <div class="mt-4 rounded-card border border-border bg-card p-5 text-center shadow-card">
      <p class="text-4xl font-bold text-accent">4 / 5</p>
      <p class="mt-2">Well done! You got 4 of 5 right.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <button
          type="button"
          class="inline-flex h-10 items-center rounded-ui bg-accent px-5 font-semibold text-accent-fg"
        >
          Try again
        </button>
        <a
          href="#"
          class="inline-flex h-10 items-center rounded-ui border border-control px-5 font-semibold"
        >
          Next topic
        </a>
      </div>
    </div>
  </section>
</Base>
