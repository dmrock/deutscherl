---
/** DESIGN OPTIONS (temporary, never in production): floating picker for the four designs. */
const options = [
  { id: 'clean', label: 'Clean' },
  { id: 'paper', label: 'Paper' },
  { id: 'friendly', label: 'Friendly' },
  { id: 'austria', label: 'Austria' },
];
---

<div
  role="group"
  aria-label="Design options"
  class="fixed end-3 bottom-20 z-40 flex items-center gap-1 rounded-full bg-fg p-1 text-sm text-bg shadow-pop lg:bottom-4"
>
  <span class="ps-2.5 pe-1 font-semibold">Design</span>
  {options.map((option, index) => (
    <button
      type="button"
      data-design-option={option.id}
      aria-pressed="false"
      title={option.label}
      class="rounded-full px-2.5 py-1 font-semibold aria-pressed:bg-bg aria-pressed:text-fg"
    >
      {index + 1}
      <span class="hidden sm:inline">&nbsp;{option.label}</span>
    </button>
  ))}
  <a href="/dev/design/" class="rounded-full px-2.5 py-1 underline underline-offset-2">
    Sample
  </a>
</div>
