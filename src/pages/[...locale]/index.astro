---
import type { GetStaticPaths } from 'astro';
import { levels } from '../../config/site.ts';
import { defaultLocale, type LocaleCode, localeCodes } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';
import Base from '../../layouts/Base.astro';

// One page per locale: the default locale at `/`, the others at `/<code>/`.
export const getStaticPaths = (() =>
  localeCodes.map((code) => ({
    params: { locale: code === defaultLocale ? undefined : code },
    props: { locale: code },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const available = levels.filter((level) => level.available);
const features = ['language', 'practice', 'austria'] as const;
---

<Base locale={locale}>
  <section class="py-6 sm:py-12">
    <p class="eyebrow text-muted">{t(locale, 'site.tagline')}</p>
    <h1 class="mt-3 max-w-2xl text-4xl sm:text-5xl">{t(locale, 'home.title')}</h1>
    <p class="mt-5 max-w-xl text-lg text-muted">{t(locale, 'home.intro')}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      {available.map((level, index) => (
        <a
          href={localizePath(`/${level.id}/`, locale)}
          class:list={[
            'inline-flex h-11 items-center rounded-ui px-5 font-semibold',
            index === 0
              ? 'bg-accent text-accent-fg hover:opacity-90'
              : 'border border-control bg-card hover:border-accent',
          ]}
        >
          {t(locale, 'home.start', { level: level.label })}
        </a>
      ))}
    </div>
  </section>

  <section class="mt-10" aria-labelledby="levels-title">
    <h2 id="levels-title" class="text-xl">
      {t(locale, 'nav.levels')}
    </h2>
    <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {levels.map((level) => (
        <li>
          <a
            href={localizePath(`/${level.id}/`, locale)}
            class:list={[
              'flex h-full flex-col rounded-card border p-4',
              level.available
                ? 'border-border bg-card shadow-card hover:border-accent'
                : 'border-dashed border-border text-muted',
            ]}
          >
            <span class:list={['text-3xl font-bold', level.available && 'text-accent']}>
              {level.label}
            </span>
            <span class="mt-1 text-sm">{t(locale, `level.${level.id}.name`)}</span>
            {!level.available && (
              <span class="mt-2 text-xs font-semibold">{t(locale, 'level.comingSoon')}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14 mb-8">
    <ul class="grid gap-6 sm:grid-cols-3">
      {features.map((feature) => (
        <li>
          <span
            aria-hidden="true"
            class="inline-flex size-10 items-center justify-center rounded-ui bg-accent-soft text-accent"
          >
            {feature === 'language' && (
              <svg
                viewBox="0 0 24 24"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />
              </svg>
            )}
            {feature === 'practice' && (
              <svg
                viewBox="0 0 24 24"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
            )}
            {feature === 'austria' && <span class="flag" />}
          </span>
          <h3 class="mt-3 text-base">{t(locale, `home.feature.${feature}.title`)}</h3>
          <p class="mt-1 text-muted">{t(locale, `home.feature.${feature}.text`)}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
