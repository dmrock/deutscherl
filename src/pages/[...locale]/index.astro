---
import type { GetStaticPaths } from 'astro';
import { levels } from '../../config/site.ts';
import { defaultLocale, type LocaleCode, localeCodes } from '../../i18n/locales.ts';
import { t } from '../../i18n/utils.ts';
import Base from '../../layouts/Base.astro';

// One page per locale: the default locale at `/`, the others at `/<code>/`.
export const getStaticPaths = (() =>
  localeCodes.map((code) => ({
    params: { locale: code === defaultLocale ? undefined : code },
    props: { locale: code },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <h1 class="text-3xl font-bold">{t(locale, 'home.title')}</h1>
  <p class="mt-4">{t(locale, 'home.intro')}</p>
  <ul class="mt-6 flex gap-4">
    {levels.map((level) => (
      <li>
        {level.label}
        {!level.available && (
          <span class="ms-1 text-sm opacity-70">({t(locale, 'level.comingSoon')})</span>
        )}
      </li>
    ))}
  </ul>
</Base>
