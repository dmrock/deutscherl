---
import type { GetStaticPaths } from 'astro';
import { levels } from '../../config/site.ts';
import { defaultLocale, type LocaleCode, localeCodes } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';
import Base from '../../layouts/Base.astro';

// One page per locale: the default locale at `/`, the others at `/<code>/`.
export const getStaticPaths = (() =>
  localeCodes.map((code) => ({
    params: { locale: code === defaultLocale ? undefined : code },
    props: { locale: code },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <h1 class="text-3xl font-bold">{t(locale, 'home.title')}</h1>
  <p class="mt-4 max-w-prose text-lg">{t(locale, 'home.intro')}</p>
  <h2 class="mt-10 text-xl font-bold">{t(locale, 'nav.levels')}</h2>
  <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {levels.map((level) => (
      <li>
        <a
          href={localizePath(`/${level.id}/`, locale)}
          class:list={[
            'flex h-full flex-col rounded-lg border border-border p-4 hover:border-accent',
            !level.available && 'text-muted',
          ]}
        >
          <span class="text-2xl font-bold">{level.label}</span>
          {!level.available && <span class="text-sm">{t(locale, 'level.comingSoon')}</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>
