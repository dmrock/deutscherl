---
import type { GetStaticPaths } from 'astro';
import MarkedText from '../../components/content/MarkedText.astro';
import { categoryIds, levels, plannedTopicsOf, site } from '../../config/site.ts';
import { defaultLocale, type LocaleCode, localeCodes } from '../../i18n/locales.ts';
import { localizePath, t } from '../../i18n/utils.ts';
import Base from '../../layouts/Base.astro';
import { referencePath, topicPath, topicsInOrder } from '../../lib/navigation.ts';
import { getReferenceLinks } from '../../lib/reference.ts';
import { websiteData } from '../../lib/seo.ts';
import { getTopicLinks } from '../../lib/topics.ts';

// One page per locale: the default locale at `/`, the others at `/<code>/`.
export const getStaticPaths = (() =>
  localeCodes.map((code) => ({
    params: { locale: code === defaultLocale ? undefined : code },
    props: { locale: code },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const available = levels.filter((level) => level.available);
const features = ['language', 'practice', 'austria'] as const;
const topicLinks = await getTopicLinks(locale);
const referenceLinks = await getReferenceLinks(locale);
const description = t(locale, 'home.intro');
const structuredData = websiteData({
  name: site.name,
  url: new URL(localizePath('/', locale), site.url).href,
  description,
  locale,
});
---

<Base locale={locale} description={description} structuredData={structuredData}>
  <section class="pt-2 sm:pt-6">
    <p class="eyebrow text-muted">{t(locale, 'site.tagline')}</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">{t(locale, 'home.title')}</h1>
    <p class="mt-4 text-lg text-muted">{t(locale, 'home.intro')}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {available.map((level, index) => (
        <a
          href={localizePath(`/${level.id}/`, locale)}
          class:list={[
            'inline-flex h-10 items-center rounded-ui px-4 font-semibold',
            index === 0
              ? 'bg-accent text-accent-fg hover:opacity-90'
              : 'border border-control bg-card hover:border-accent',
          ]}
        >
          {t(locale, 'home.start', { level: level.label })}
        </a>
      ))}
    </div>
  </section>

  <section class="mt-10" aria-labelledby="levels-title">
    <h2 id="levels-title" class="text-xl">
      {t(locale, 'nav.levels')}
    </h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {levels.map((level) => {
        const topics = level.available ? topicsInOrder(topicLinks, level.id, categoryIds) : [];
        return (
          <li
            class:list={[
              'flex flex-col rounded-card border px-4 py-3',
              level.available ? 'border-border bg-card shadow-card' : 'border-dashed border-border',
            ]}
          >
            <h3 class="text-base">
              <a
                href={localizePath(`/${level.id}/`, locale)}
                class="inline-flex items-baseline gap-2 hover:text-accent"
              >
                <span
                  class:list={[
                    'text-2xl font-bold',
                    level.available ? 'text-accent' : 'text-muted',
                  ]}
                >
                  {level.label}
                </span>
                {t(locale, `level.${level.id}.name`)}
              </a>
            </h3>
            {level.available && topics.length > 0 && (
              <ul class="mt-1 text-sm">
                {topics.map((topic) => (
                  <li>
                    <a
                      href={localizePath(topicPath(topic), locale)}
                      class="inline-block py-0.5 hover:text-accent"
                    >
                      {topic.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {level.available && topics.length === 0 && (
              <p class="mt-1.5 text-sm text-muted">{t(locale, 'level.noTopics')}</p>
            )}
            {!level.available && (
              <>
                <p class="eyebrow mt-1.5 text-muted">{t(locale, 'level.comingSoon')}</p>
                <ul class="mt-1 space-y-0.5 text-sm text-muted">
                  {plannedTopicsOf(level.id).map((id) => (
                    <li>
                      <MarkedText text={t(locale, `planned.${id}`)} />
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mt-10" aria-labelledby="reference-title">
    <h2 id="reference-title" class="text-xl">
      <a href={localizePath(referencePath(), locale)} class="hover:text-accent">
        {t(locale, 'reference.title')}
      </a>
    </h2>
    <div class="mt-3 rounded-card border border-border bg-card px-4 py-3 shadow-card">
      <p class="text-muted">{t(locale, 'home.reference.text')}</p>
      {referenceLinks.length > 0 && (
        <ul class="mt-1 grid text-sm sm:grid-cols-2 lg:grid-cols-3">
          {referenceLinks.map((page) => (
            <li>
              <a
                href={localizePath(referencePath(page.slug), locale)}
                class="inline-block py-0.5 hover:text-accent"
              >
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="mt-10 mb-4">
    <ul class="grid gap-5 sm:grid-cols-3">
      {features.map((feature) => (
        <li>
          <span
            aria-hidden="true"
            class="inline-flex size-9 items-center justify-center rounded-ui bg-accent-soft text-accent"
          >
            {feature === 'language' && (
              <svg
                viewBox="0 0 24 24"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />
              </svg>
            )}
            {feature === 'practice' && (
              <svg
                viewBox="0 0 24 24"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
            )}
            {feature === 'austria' && <span class="flag" />}
          </span>
          <h3 class="mt-2 text-base">{t(locale, `home.feature.${feature}.title`)}</h3>
          <p class="mt-0.5 text-muted">{t(locale, `home.feature.${feature}.text`)}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
