---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import { PUBLIC_DEPLOY_ENV } from 'astro:env/client';
import type { GetStaticPaths } from 'astro';
import AustrianNote from '../../../../components/content/AustrianNote.astro';
import De from '../../../../components/content/De.astro';
import Example from '../../../../components/content/Example.astro';
import Examples from '../../../../components/content/Examples.astro';
import InShort from '../../../../components/content/InShort.astro';
import RuleTable from '../../../../components/content/RuleTable.astro';
import SponsorSlot from '../../../../components/content/SponsorSlot.astro';
import StatusBadges from '../../../../components/content/StatusBadges.astro';
import ExerciseRunner from '../../../../components/exercises/ExerciseRunner.svelte';
import TopicPager from '../../../../components/layout/TopicPager.astro';
import { categoryIds, type LevelId, levelIds, levels, site } from '../../../../config/site.ts';
import {
  defaultLocale,
  getLocaleConfig,
  isLocaleCode,
  type LocaleCode,
} from '../../../../i18n/locales.ts';
import { localizePath, t } from '../../../../i18n/utils.ts';
import Base from '../../../../layouts/Base.astro';
import { exerciseStrings } from '../../../../lib/exercise-strings.ts';
import { resolveExercises, seenKey } from '../../../../lib/exercises.ts';
import { stripMarks } from '../../../../lib/marked-text.ts';
import { neighbours } from '../../../../lib/navigation.ts';
import { breadcrumbData, topicData } from '../../../../lib/seo.ts';
import { getTopicContent } from '../../../../lib/topic-content.ts';
import { getTopicLinks } from '../../../../lib/topics.ts';

// One page per topic MDX file: `a2/perfekt/ru.mdx` becomes `/ru/a2/perfekt/`.
export const getStaticPaths = (async () => {
  const pages = await getCollection('topics');
  const paths = [];
  for (const page of pages) {
    const [folderLevel, slug, locale] = page.id.split('/');
    if (!folderLevel || !slug || !locale || !isLocaleCode(locale)) {
      throw new Error(`Unexpected topic file: ${page.id}`);
    }
    const meta = await getEntry('topicMeta', `${folderLevel}/${slug}`);
    if (!meta) throw new Error(`Missing meta.yaml for ${folderLevel}/${slug}`);
    paths.push({
      params: {
        locale: locale === defaultLocale ? undefined : locale,
        level: meta.data.level,
        topic: slug,
      },
      props: { locale, level: meta.data.level, slug, page, meta },
    });
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
  level: LevelId;
  slug: string;
  page: CollectionEntry<'topics'>;
  meta: CollectionEntry<'topicMeta'>;
}

const { locale, level, slug, page, meta } = Astro.props;
const { Content } = await render(page);
const { german, i18n, review } = await getTopicContent(level, slug, locale);
const pageUrl = new URL(localizePath(Astro.url.pathname, locale), site.url).href;
const levelLabel = levels.find((entry) => entry.id === level)?.label ?? level;
const description = stripMarks(page.data.summary);
const structuredData = [
  topicData({ title: page.data.title, description, url: pageUrl, locale, level: levelLabel }),
  breadcrumbData([
    { name: site.name, url: new URL(localizePath('/', locale), site.url).href },
    {
      name: t(locale, 'level.title', { level: levelLabel }),
      url: new URL(localizePath(`/${level}/`, locale), site.url).href,
    },
    { name: page.data.title, url: pageUrl },
  ]),
];
// Search indexes topic pages of ready locales only (Pagefind indexes only pages with this attribute).
const searchable = getLocaleConfig(locale).ready;
const { prev, next } = neighbours(await getTopicLinks(locale), level, slug, categoryIds, levelIds);
---

<Base
  locale={locale}
  title={page.data.title}
  description={description}
  level={level}
  topic={slug}
  ogType="article"
  structuredData={structuredData}
>
  <!-- Target of the "back to the explanation" links in the practice card. -->
  <article id="explanation" class="scroll-mt-16" data-pagefind-body={searchable ? '' : undefined}>
    <p class="eyebrow text-muted">
      {levelLabel} · {t(locale, `category.${meta.data.category}`)}
    </p>
    <h1 class="mt-0.5 text-2xl sm:text-3xl">{page.data.title}</h1>
    <div class="mt-2 flex items-center justify-between gap-3" data-pagefind-ignore>
      <div class="text-xs">
        <StatusBadges locale={locale} review={review} />
      </div>
      <!-- Jump to the practice card at the end of the page; the card links back with "↑ Explanation". -->
      <a
        href="#practice"
        class="inline-flex shrink-0 items-center gap-1 text-sm text-muted hover:text-accent"
      >
        <span aria-hidden="true">↓</span>
        {t(locale, 'nav.practice')}
      </a>
    </div>
    <InShort locale={locale} summary={page.data.summary} />
    <div class="topic-prose mt-4">
      <Content components={{ AustrianNote, De, Example, Examples, RuleTable }} />
    </div>
  </article>
  <SponsorSlot />
  <!-- Practice: reserves the screen while a round runs (ExerciseRunner, global.css). Sources stay in meta.yaml for review, not shown. -->
  <div data-practice-area>
    <div>
      <section
        id="practice"
        class="mt-6 scroll-mt-16 rounded-card border border-border bg-card px-3 py-2.5 shadow-card"
        aria-labelledby="practice-title"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h2 id="practice-title" class="text-xl">
            {t(locale, 'nav.practice')}
          </h2>
          <!-- Only while a round runs: before "Start" the explanation is right above. -->
          <a
            href="#explanation"
            class="practice-only inline-flex items-center gap-1 text-sm text-muted hover:text-accent"
          >
            <span aria-hidden="true">↑</span>
            {t(locale, 'exercise.toExplanation')}
          </a>
        </div>
        <noscript>
          <p class="mt-2">{t(locale, 'exercise.needsJs')}</p>
        </noscript>
        <div class="mt-3">
          <ExerciseRunner
            client:visible
            items={resolveExercises(german, i18n)}
            strings={exerciseStrings(locale)}
            storageKey={seenKey(level, slug)}
            locale={locale}
            pageUrl={pageUrl}
            repo={site.repo}
            allowSeed={PUBLIC_DEPLOY_ENV !== 'production'}
          />
        </div>
      </section>
    </div>
  </div>
  <TopicPager locale={locale} level={level} prev={prev} next={next} />
</Base>
