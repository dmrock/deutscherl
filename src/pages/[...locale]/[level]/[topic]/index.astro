---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AustrianNote from '../../../../components/content/AustrianNote.astro';
import De from '../../../../components/content/De.astro';
import Example from '../../../../components/content/Example.astro';
import Examples from '../../../../components/content/Examples.astro';
import InShort from '../../../../components/content/InShort.astro';
import RuleTable from '../../../../components/content/RuleTable.astro';
import SpeakScript from '../../../../components/content/SpeakScript.astro';
import SponsorSlot from '../../../../components/content/SponsorSlot.astro';
import StatusBadges from '../../../../components/content/StatusBadges.astro';
import { type LevelId, levels } from '../../../../config/site.ts';
import { defaultLocale, isLocaleCode, type LocaleCode } from '../../../../i18n/locales.ts';
import { t } from '../../../../i18n/utils.ts';
import Base from '../../../../layouts/Base.astro';
import { stripMarks } from '../../../../lib/marked-text.ts';
import { getTopicContent } from '../../../../lib/topic-content.ts';

// One page per topic MDX file: `a2/perfekt/ru.mdx` becomes `/ru/a2/perfekt/`.
export const getStaticPaths = (async () => {
  const pages = await getCollection('topics');
  const paths = [];
  for (const page of pages) {
    const [folderLevel, slug, locale] = page.id.split('/');
    if (!folderLevel || !slug || !locale || !isLocaleCode(locale)) {
      throw new Error(`Unexpected topic file: ${page.id}`);
    }
    const meta = await getEntry('topicMeta', `${folderLevel}/${slug}`);
    if (!meta) throw new Error(`Missing meta.yaml for ${folderLevel}/${slug}`);
    paths.push({
      params: {
        locale: locale === defaultLocale ? undefined : locale,
        level: meta.data.level,
        topic: slug,
      },
      props: { locale, level: meta.data.level, slug, page, meta },
    });
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
  level: LevelId;
  slug: string;
  page: CollectionEntry<'topics'>;
  meta: CollectionEntry<'topicMeta'>;
}

const { locale, level, slug, page, meta } = Astro.props;
const { Content } = await render(page);
const { review } = await getTopicContent(level, slug, locale);
const levelLabel = levels.find((entry) => entry.id === level)?.label ?? level;
---

<Base
  locale={locale}
  title={page.data.title}
  description={stripMarks(page.data.summary)}
  level={level}
  topic={slug}
>
  <article class="max-w-prose">
    <p class="eyebrow text-muted">
      {levelLabel} · {t(locale, `category.${meta.data.category}`)}
    </p>
    <h1 class="mt-1 text-3xl sm:text-4xl">{page.data.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
      <StatusBadges locale={locale} review={review} path={Astro.url.pathname} />
      <span class="text-muted">
        {t(locale, 'topic.readingTime', { minutes: meta.data.readingMinutes })}
      </span>
      <label class="ms-auto inline-flex cursor-pointer items-center gap-2 text-sm text-muted">
        <input id="hide-translations" type="checkbox" class="size-4 accent-accent" />
        {t(locale, 'topic.hideTranslations')}
      </label>
    </div>
    <InShort locale={locale} summary={page.data.summary} />
    <div class="topic-prose mt-6">
      <Content components={{ AustrianNote, De, Example, Examples, RuleTable }} />
    </div>
    <section class="mt-8 border-t border-border pt-4" aria-labelledby="sources-title">
      <h2 id="sources-title" class="text-lg">
        {t(locale, 'topic.sources')}
      </h2>
      <ul class="mt-2 space-y-1 text-sm text-muted">
        {meta.data.sources.map((source) => (
          <li lang="de">
            {source.url ? (
              <a href={source.url} class="underline underline-offset-2 hover:text-accent">
                {source.title}
              </a>
            ) : (
              source.title
            )}
          </li>
        ))}
      </ul>
    </section>
  </article>
  <SponsorSlot />
  <section
    id="practice"
    class="mt-10 max-w-prose scroll-mt-16 rounded-card border border-border bg-card p-4 shadow-card"
    aria-labelledby="practice-title"
  >
    <h2 id="practice-title" class="text-2xl">
      {t(locale, 'nav.practice')}
    </h2>
    <p class="mt-2 text-muted">{t(locale, 'topic.practiceSoon')}</p>
  </section>
  <SpeakScript />
</Base>
