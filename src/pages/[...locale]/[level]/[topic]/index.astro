---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import { PUBLIC_DEPLOY_ENV } from 'astro:env/client';
import type { GetStaticPaths } from 'astro';
import AustrianNote from '../../../../components/content/AustrianNote.astro';
import De from '../../../../components/content/De.astro';
import Example from '../../../../components/content/Example.astro';
import Examples from '../../../../components/content/Examples.astro';
import InShort from '../../../../components/content/InShort.astro';
import RuleTable from '../../../../components/content/RuleTable.astro';
import SponsorSlot from '../../../../components/content/SponsorSlot.astro';
import StatusBadges from '../../../../components/content/StatusBadges.astro';
import ExerciseRunner from '../../../../components/exercises/ExerciseRunner.svelte';
import { type LevelId, levels, site } from '../../../../config/site.ts';
import { defaultLocale, isLocaleCode, type LocaleCode } from '../../../../i18n/locales.ts';
import { localizePath, t } from '../../../../i18n/utils.ts';
import Base from '../../../../layouts/Base.astro';
import { exerciseStrings } from '../../../../lib/exercise-strings.ts';
import { resolveExercises, seenKey } from '../../../../lib/exercises.ts';
import { stripMarks } from '../../../../lib/marked-text.ts';
import { getTopicContent } from '../../../../lib/topic-content.ts';

// One page per topic MDX file: `a2/perfekt/ru.mdx` becomes `/ru/a2/perfekt/`.
export const getStaticPaths = (async () => {
  const pages = await getCollection('topics');
  const paths = [];
  for (const page of pages) {
    const [folderLevel, slug, locale] = page.id.split('/');
    if (!folderLevel || !slug || !locale || !isLocaleCode(locale)) {
      throw new Error(`Unexpected topic file: ${page.id}`);
    }
    const meta = await getEntry('topicMeta', `${folderLevel}/${slug}`);
    if (!meta) throw new Error(`Missing meta.yaml for ${folderLevel}/${slug}`);
    paths.push({
      params: {
        locale: locale === defaultLocale ? undefined : locale,
        level: meta.data.level,
        topic: slug,
      },
      props: { locale, level: meta.data.level, slug, page, meta },
    });
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
  level: LevelId;
  slug: string;
  page: CollectionEntry<'topics'>;
  meta: CollectionEntry<'topicMeta'>;
}

const { locale, level, slug, page, meta } = Astro.props;
const { Content } = await render(page);
const { german, i18n, review } = await getTopicContent(level, slug, locale);
const pageUrl = new URL(localizePath(Astro.url.pathname, locale), site.url).href;
const levelLabel = levels.find((entry) => entry.id === level)?.label ?? level;
---

<Base
  locale={locale}
  title={page.data.title}
  description={stripMarks(page.data.summary)}
  level={level}
  topic={slug}
>
  <article>
    <p class="eyebrow text-muted">
      {levelLabel} · {t(locale, `category.${meta.data.category}`)}
    </p>
    <h1 class="mt-0.5 text-2xl sm:text-3xl">{page.data.title}</h1>
    <div class="mt-2 text-xs">
      <StatusBadges locale={locale} review={review} />
    </div>
    <InShort locale={locale} summary={page.data.summary} />
    <div class="topic-prose mt-4">
      <Content components={{ AustrianNote, De, Example, Examples, RuleTable }} />
    </div>
  </article>
  <SponsorSlot />
  <!-- Practice and sources: reserves the screen while a round runs (ExerciseRunner, global.css). -->
  <div data-practice-area>
    <div>
      <section
        id="practice"
        class="mt-6 scroll-mt-16 rounded-card border border-border bg-card px-3 py-2.5 shadow-card"
        aria-labelledby="practice-title"
      >
        <h2 id="practice-title" class="text-xl">
          {t(locale, 'nav.practice')}
        </h2>
        <p class="mt-1 text-muted">{t(locale, 'exercise.intro')}</p>
        <noscript>
          <p class="mt-2">{t(locale, 'exercise.needsJs')}</p>
        </noscript>
        <div class="mt-3">
          <ExerciseRunner
            client:visible
            items={resolveExercises(german, i18n)}
            strings={exerciseStrings(locale)}
            storageKey={seenKey(level, slug)}
            locale={locale}
            pageUrl={pageUrl}
            repo={site.repo}
            allowSeed={PUBLIC_DEPLOY_ENV !== 'production'}
          />
        </div>
      </section>
      <section class="mt-6 border-t border-border pt-3" aria-labelledby="sources-title">
        <h2 id="sources-title" class="text-base">
          {t(locale, 'topic.sources')}
        </h2>
        <ul class="mt-1 space-y-0.5 text-sm text-muted">
          {meta.data.sources.map((source) => (
            <li lang="de">
              {source.url ? (
                <a href={source.url} class="underline underline-offset-2 hover:text-accent">
                  {source.title}
                </a>
              ) : (
                source.title
              )}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>
