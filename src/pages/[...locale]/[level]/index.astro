---
import type { GetStaticPaths } from 'astro';
import { categoryIds, type Level, levels } from '../../../config/site.ts';
import { defaultLocale, type LocaleCode, localeCodes } from '../../../i18n/locales.ts';
import { localizePath, t } from '../../../i18n/utils.ts';
import Base from '../../../layouts/Base.astro';
import { groupByCategory, topicPath } from '../../../lib/navigation.ts';
import { getTopicLinks } from '../../../lib/topics.ts';

// Every level in every locale; levels that are not available yet are coming-soon pages (noindex).
export const getStaticPaths = (() =>
  localeCodes.flatMap((code) =>
    levels.map((level) => ({
      params: { locale: code === defaultLocale ? undefined : code, level: level.id },
      props: { locale: code, level },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
  level: Level;
}

const { locale, level } = Astro.props;
const title = t(locale, 'level.title', { level: level.label });
const groups = level.available
  ? groupByCategory(await getTopicLinks(locale), level.id, categoryIds)
  : [];
---

<Base locale={locale} title={title} level={level.id} noindex={!level.available}>
  <p class="eyebrow text-muted">{t(locale, `level.${level.id}.name`)}</p>
  <h1 class="mt-1 text-3xl sm:text-4xl">{title}</h1>
  {!level.available && (
    <p class="mt-4 max-w-prose text-lg">
      <span class="font-semibold">{t(locale, 'level.comingSoon')}.</span>{' '}
      {t(locale, 'level.comingSoonText')}
    </p>
  )}
  {level.available && groups.length === 0 && (
    <p class="mt-4 text-lg text-muted">{t(locale, 'level.noTopics')}</p>
  )}
  {groups.map((group) => (
    <section class="mt-8">
      <h2 class="text-xl">{t(locale, `category.${group.category}`)}</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {group.topics.map((topic) => (
          <li>
            <a
              href={localizePath(topicPath(topic), locale)}
              class="group flex h-full flex-col rounded-card border border-border bg-card px-4 py-3 shadow-card hover:border-accent"
            >
              <span class="font-semibold group-hover:text-accent">{topic.title}</span>
              <span class="mt-1 text-sm text-muted">{topic.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
