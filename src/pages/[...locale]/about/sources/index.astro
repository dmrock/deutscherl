---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { defaultLocale, type LocaleCode, localeCodes } from '../../../../i18n/locales.ts';
import { localizePath, t } from '../../../../i18n/utils.ts';
import Base from '../../../../layouts/Base.astro';
import { topicPath } from '../../../../lib/navigation.ts';
import { groupSources } from '../../../../lib/sources.ts';
import { getTopicLinks } from '../../../../lib/topics.ts';

// Grammar references of all topics (meta.yaml `sources`), not shown on topic pages (decision #78).
export const getStaticPaths = (() =>
  localeCodes.map((code) => ({
    params: { locale: code === defaultLocale ? undefined : code },
    props: { locale: code },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const metas = await getCollection('topicMeta');
const groups = groupSources(metas.map((meta) => ({ key: meta.id, sources: meta.data.sources })));
const topics = new Map(
  (await getTopicLinks(locale)).map((topic) => [`${topic.level}/${topic.slug}`, topic]),
);
const title = t(locale, 'sources.title');
---

<Base locale={locale} title={title} description={t(locale, 'sources.description')}>
  <h1 class="text-2xl sm:text-3xl">{title}</h1>
  <p class="mt-3 max-w-prose">{t(locale, 'sources.intro')}</p>
  {groups.map((group) => (
    <section class="mt-6">
      <h2 class="text-lg">{group.site ?? t(locale, 'sources.noUrl')}</h2>
      <ul class="mt-2 space-y-2">
        {group.sources.map((source) => (
          <li class="rounded-card border border-border bg-card px-3 py-2 shadow-card">
            {source.url ? (
              <a href={source.url} class="font-semibold text-accent underline">
                {source.title}
              </a>
            ) : (
              <span class="font-semibold">{source.title}</span>
            )}
            <p class="mt-0.5 text-sm text-muted">
              {t(locale, 'sources.usedIn')}{' '}
              {source.topics.map((key, index) => {
                const topic = topics.get(key);
                return (
                  <>
                    {index > 0 && ', '}
                    {topic ? (
                      <a
                        href={localizePath(topicPath(topic), locale)}
                        class="underline hover:text-accent"
                      >
                        {topic.title}
                      </a>
                    ) : (
                      key
                    )}
                  </>
                );
              })}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
