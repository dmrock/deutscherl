{"word":"See","pos":"noun","lang_code":"de","head_templates":[{"name":"de-noun","args":{"1":"m"}}],"forms":[{"form":"Sees","tags":["genitive"]},{"form":"Seen","tags":["plural"]}],"senses":[{"glosses":["lake"],"tags":["masculine","mixed"],"examples":[{"text":"Dieser See ist sehr klein.","english":"This lake is very small.","translation":"This lake is very small.","type":"example"},{"text":"\"Görlitzer Park\", Berliner Zeitung, November 11, 2013.\nAuf 14 Hektar gibt es unter anderem einen Kinderbauernhof, mehrere Sport-, Spiel- und Bolzplätze, zwei Aussichtsberge und einen kleinen See.","english":"There are, among other things, a petting zoo, multiple sporting facilities, playing grounds and soccer fields, two overlooks and a small lake on 14 hectares.","translation":"There are, among other things, a petting zoo, multiple sporting facilities, playing grounds and soccer fields, two overlooks and a small lake on 14 hectares.","type":"quotation"}]}]}
